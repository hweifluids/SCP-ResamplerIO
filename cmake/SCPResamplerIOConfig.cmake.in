@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET SCP::SolverSDK)
  find_dependency(SCPSolverSDK CONFIG)
endif()

set(SCPResamplerIO_Readers_FOUND TRUE)
set(SCPResamplerIO_Full_FOUND @SCP_RESAMPLER_IO_BUILD_FULL_LIBRARY@)
set(_scp_resampler_io_need_full FALSE)
if(NOT SCPResamplerIO_FIND_COMPONENTS OR "Full" IN_LIST SCPResamplerIO_FIND_COMPONENTS)
  set(_scp_resampler_io_need_full TRUE)
endif()
foreach(_scp_resampler_io_requested IN LISTS SCPResamplerIO_FIND_COMPONENTS)
  if(NOT _scp_resampler_io_requested STREQUAL "Readers" AND
     NOT _scp_resampler_io_requested STREQUAL "Full")
    set("SCPResamplerIO_${_scp_resampler_io_requested}_FOUND" FALSE)
  endif()
endforeach()
if(_scp_resampler_io_need_full AND SCPResamplerIO_Full_FOUND AND
   NOT TARGET Qt6::Core)
  find_dependency(Qt6 6.5 COMPONENTS Core)
endif()
set(_scp_resampler_io_vtk_components @SCP_RESAMPLER_IO_VTK_COMPONENTS@)
set(_scp_resampler_io_needs_vtk FALSE)
foreach(_scp_resampler_io_component IN LISTS _scp_resampler_io_vtk_components)
  if(NOT TARGET "VTK::${_scp_resampler_io_component}")
    set(_scp_resampler_io_needs_vtk TRUE)
    break()
  endif()
endforeach()
if(_scp_resampler_io_needs_vtk)
  find_dependency(VTK CONFIG COMPONENTS @SCP_RESAMPLER_IO_VTK_COMPONENTS@)
endif()
unset(_scp_resampler_io_component)
unset(_scp_resampler_io_needs_vtk)
unset(_scp_resampler_io_vtk_components)
unset(_scp_resampler_io_need_full)
unset(_scp_resampler_io_requested)

include("${CMAKE_CURRENT_LIST_DIR}/SCPResamplerIOTargets.cmake")

check_required_components(SCPResamplerIO)
if(NOT SCPResamplerIO_FIND_COMPONENTS AND NOT SCPResamplerIO_Full_FOUND)
  set(SCPResamplerIO_FOUND FALSE)
  set(SCPResamplerIO_NOT_FOUND_MESSAGE
    "This SCPResamplerIO package contains only the Readers component; request COMPONENTS Readers.")
endif()
