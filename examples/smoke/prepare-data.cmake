cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED SMOKE_ROOT OR SMOKE_ROOT STREQUAL "")
  get_filename_component(SMOKE_ROOT "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
endif()

get_filename_component(module_root "${SMOKE_ROOT}/../.." ABSOLUTE)
get_filename_component(module_name "${module_root}" NAME)
get_filename_component(module_parent "${module_root}" DIRECTORY)
get_filename_component(module_parent_name "${module_parent}" NAME)
get_filename_component(super_root "${module_parent}" DIRECTORY)
if(module_parent_name STREQUAL "modules"
    AND EXISTS "${super_root}/.git"
    AND EXISTS "${super_root}/modules/components.json")
  set(test_root "${super_root}/.tests")
  set(integrated_examples "${super_root}/examples/SCP-examples")
else()
  set(test_root "${module_root}/.tests")
  set(integrated_examples "")
endif()

set(work_root "${test_root}/smoke/${module_name}")
set(cache_dir "${work_root}/cache")
set(data_dir "${work_root}/data")
file(MAKE_DIRECTORY "${cache_dir}")

set(metadata_path "${SMOKE_ROOT}/dataset.json")
if(NOT EXISTS "${metadata_path}")
  message(FATAL_ERROR "Missing smoke dataset metadata: ${metadata_path}")
endif()

file(READ "${metadata_path}" metadata)
string(JSON status GET "${metadata}" status)
string(JSON repository GET "${metadata}" repository)
string(JSON release_tag GET "${metadata}" release_tag)
string(JSON data_subdirectory GET "${metadata}" data_subdirectory)
string(JSON asset_name GET "${metadata}" asset_name)
string(JSON archive_sha256 GET "${metadata}" sha256)
string(JSON manifest_sha256 GET "${metadata}" manifest_sha256)
string(JSON collection_sha256 GET "${metadata}" collection_sha256)

foreach(hash_name IN ITEMS archive_sha256 manifest_sha256 collection_sha256)
  string(TOLOWER "${${hash_name}}" ${hash_name})
  string(LENGTH "${${hash_name}}" hash_length)
  if(NOT hash_length EQUAL 64 OR "${${hash_name}}" MATCHES "[^0-9a-f]")
    message(FATAL_ERROR "dataset.json contains an invalid ${hash_name} value.")
  endif()
endforeach()
if(NOT status STREQUAL "published"
    OR NOT repository STREQUAL "hweifluids/SCP-examples"
    OR NOT data_subdirectory STREQUAL "hemi_resampled")
  message(FATAL_ERROR "dataset.json must reference the published SCP-examples/hemi_resampled contract.")
endif()

function(validate_dataset_directory candidate result_var reason_var)
  set(valid TRUE)
  set(reason "")
  set(candidate_manifest "${candidate}/dataset.json")
  set(candidate_collection "${candidate}/hemisphere_re1370_250x80x50.pvd")
  if(NOT EXISTS "${candidate_manifest}" OR NOT EXISTS "${candidate_collection}")
    set(valid FALSE)
    set(reason "missing dataset.json or PVD")
  endif()

  if(valid)
    file(SHA256 "${candidate_manifest}" actual_manifest_sha256)
    file(SHA256 "${candidate_collection}" actual_collection_sha256)
    if(NOT actual_manifest_sha256 STREQUAL manifest_sha256)
      set(valid FALSE)
      set(reason "dataset.json SHA-256 mismatch")
    elseif(NOT actual_collection_sha256 STREQUAL collection_sha256)
      set(valid FALSE)
      set(reason "PVD SHA-256 mismatch")
    endif()
  endif()

  if(valid)
    file(READ "${candidate_manifest}" inner_manifest)
    string(JSON frame_count ERROR_VARIABLE json_error LENGTH "${inner_manifest}" files)
    if(NOT json_error STREQUAL "NOTFOUND" OR NOT frame_count EQUAL 20)
      set(valid FALSE)
      set(reason "dataset.json does not describe exactly 20 frames")
    endif()
  endif()

  if(valid)
    math(EXPR last_frame "${frame_count} - 1")
    foreach(index RANGE 0 ${last_frame})
      string(JSON frame_name GET "${inner_manifest}" files ${index} name)
      string(JSON expected_bytes GET "${inner_manifest}" files ${index} bytes)
      string(JSON expected_sha256 GET "${inner_manifest}" files ${index} sha256)
      set(frame_path "${candidate}/${frame_name}")
      if(NOT EXISTS "${frame_path}")
        set(valid FALSE)
        set(reason "missing frame ${frame_name}")
        break()
      endif()
      file(SIZE "${frame_path}" actual_bytes)
      if(NOT actual_bytes EQUAL expected_bytes)
        set(valid FALSE)
        set(reason "byte-count mismatch for ${frame_name}; Git LFS data may not be hydrated")
        break()
      endif()
      file(SHA256 "${frame_path}" actual_sha256)
      if(NOT actual_sha256 STREQUAL expected_sha256)
        set(valid FALSE)
        set(reason "SHA-256 mismatch for ${frame_name}")
        break()
      endif()
    endforeach()
  endif()

  if(valid)
    file(GLOB frames LIST_DIRECTORIES false "${candidate}/*.vti")
    list(LENGTH frames actual_frame_count)
    if(NOT actual_frame_count EQUAL 20)
      set(valid FALSE)
      set(reason "expected exactly 20 VTI files")
    endif()
  endif()

  set(${result_var} ${valid} PARENT_SCOPE)
  set(${reason_var} "${reason}" PARENT_SCOPE)
endfunction()

validate_dataset_directory("${data_dir}" data_ready data_reason)
if(data_ready)
  message(STATUS "Verified smoke data already prepared at ${data_dir}")
  return()
endif()

set(dataset_source "")
set(dataset_candidates "")
if(NOT integrated_examples STREQUAL "")
  list(APPEND dataset_candidates "${integrated_examples}/${data_subdirectory}")
endif()
list(APPEND dataset_candidates
  "${module_parent}/SCP-examples/${data_subdirectory}"
  "${module_root}/.deps/SCP-examples/${data_subdirectory}")

foreach(candidate IN LISTS dataset_candidates)
  validate_dataset_directory("${candidate}" candidate_valid candidate_reason)
  if(candidate_valid)
    set(dataset_source "${candidate}")
    break()
  endif()
endforeach()

if(NOT dataset_source STREQUAL "")
  file(REMOVE_RECURSE "${data_dir}")
  file(MAKE_DIRECTORY "${data_dir}")
  file(COPY "${dataset_source}/" DESTINATION "${data_dir}")
else()
  set(shared_archive "${test_root}/smoke_asset/${asset_name}")
  set(cached_archive "${cache_dir}/${asset_name}")
  set(archive_path "")
  foreach(candidate IN ITEMS "${shared_archive}" "${cached_archive}")
    if(EXISTS "${candidate}")
      file(SHA256 "${candidate}" candidate_sha256)
      string(TOLOWER "${candidate_sha256}" candidate_sha256)
      if(candidate_sha256 STREQUAL archive_sha256)
        set(archive_path "${candidate}")
        break()
      elseif(candidate STREQUAL cached_archive)
        file(REMOVE "${cached_archive}")
      endif()
    endif()
  endforeach()

  if(archive_path STREQUAL "")
    find_program(GH_EXECUTABLE NAMES gh)
    if(NOT GH_EXECUTABLE)
      message(FATAL_ERROR
        "SCP-examples was not found as the superproject submodule or a sibling checkout, and GitHub CLI "
        "is unavailable. Clone the private hweifluids/SCP-examples repository beside this module, or "
        "install/authenticate gh so the smoke-data-v1 release can be downloaded.")
    endif()
    file(REMOVE "${cached_archive}")
    execute_process(
      COMMAND "${GH_EXECUTABLE}" release download "${release_tag}"
        --repo "${repository}" --pattern "${asset_name}" --output "${cached_archive}" --clobber
      RESULT_VARIABLE download_result
      OUTPUT_VARIABLE download_stdout
      ERROR_VARIABLE download_stderr
    )
    if(NOT download_result EQUAL 0 OR NOT EXISTS "${cached_archive}")
      file(REMOVE "${cached_archive}")
      message(FATAL_ERROR
        "Unable to download the private SCP-examples ${release_tag} asset. Authenticate gh and retry. "
        "Details: ${download_stderr}")
    endif()
    file(SHA256 "${cached_archive}" downloaded_sha256)
    string(TOLOWER "${downloaded_sha256}" downloaded_sha256)
    if(NOT downloaded_sha256 STREQUAL archive_sha256)
      file(REMOVE "${cached_archive}")
      message(FATAL_ERROR "Downloaded SCP-examples archive failed SHA-256 verification.")
    endif()
    set(archive_path "${cached_archive}")
  endif()

  file(REMOVE_RECURSE "${data_dir}")
  file(MAKE_DIRECTORY "${data_dir}")
  file(ARCHIVE_EXTRACT INPUT "${archive_path}" DESTINATION "${data_dir}")
endif()

validate_dataset_directory("${data_dir}" prepared_valid prepared_reason)
if(NOT prepared_valid)
  file(REMOVE_RECURSE "${data_dir}")
  message(FATAL_ERROR "Prepared smoke dataset is invalid: ${prepared_reason}")
endif()

message(STATUS "Verified smoke data prepared at ${data_dir}")
